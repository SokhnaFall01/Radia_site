// Prisma schema — Radia Glam
// Modele de donnees principal (voir section 05 de l'architecture fonctionnelle)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENTE
  STAFF
  ADMIN
}

enum StatutRdv {
  EN_ATTENTE
  CONFIRME
  HONORE
  ABSENT
  ANNULE
}

enum OrigineRdv {
  EN_LIGNE
  MANUEL
}

enum StatutInscription {
  CONFIRMEE
  LISTE_ATTENTE
  ANNULEE
}

enum StatutCommande {
  EN_ATTENTE
  PAYEE
  PREPAREE
  LIVREE
  ANNULEE
}

enum TypeLivraison {
  LIVRAISON
  RETRAIT_SALON
}

enum TypePaiement {
  FORMATION
  RENDEZ_VOUS
  BOUTIQUE
}

enum MoyenPaiement {
  WAVE
  ORANGE_MONEY
  FREE_MONEY
  CARTE_BANCAIRE
  ESPECES_SALON
}

enum StatutPaiement {
  EN_ATTENTE
  PARTIEL
  PAYE
  ECHOUE
  REMBOURSE
}

enum CanalNotification {
  WHATSAPP
  EMAIL
}

enum TypeNotification {
  CONFIRMATION
  RAPPEL
  ANNONCE
  RECU
}

enum StatutEnvoi {
  EN_ATTENTE
  ENVOYE
  ECHOUE
}

enum TypeEvenement {
  MARIAGE
  HENNE
  MAQUILLAGE_SIMPLE
  AUTRE
}

enum StatutDevis {
  NOUVEAU
  EN_COURS
  ENVOYE
  ACCEPTE
  REFUSE
}

model User {
  id           String   @id @default(cuid())
  nom          String
  email        String   @unique
  telephone    String?
  passwordHash String
  role         Role     @default(CLIENTE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inscriptions      Inscription[]
  rendezVousClient  RendezVous[]    @relation("ClienteRdv")
  rendezVousStaff   RendezVous[]    @relation("MaquilleuseRdv")
  commandes         Commande[]
  paiements         Paiement[]
  notifications     Notification[]
  certificats       Certificat[]
  progressions      Progression[]
  demandesDevis     DemandeDevis[]

  @@index([role])
}

model Formation {
  id          String   @id @default(cuid())
  titre       String
  description String
  programme   String
  duree       String
  tarifFcfa   Int
  niveau      String
  photos      String[]
  publie      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sessions Sessionformation[]
  lecons   Lecon[]
}

model Sessionformation {
  id              String   @id @default(cuid())
  formation       Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  formationId     String
  dateDebut       DateTime
  dateFin         DateTime
  placesMax       Int
  placesRestantes Int

  inscriptions Inscription[]

  @@index([formationId])
}

model Inscription {
  id        String            @id @default(cuid())
  eleve     User              @relation(fields: [eleveId], references: [id])
  eleveId   String
  session   Sessionformation  @relation(fields: [sessionId], references: [id])
  sessionId String
  statut    StatutInscription @default(CONFIRMEE)
  createdAt DateTime          @default(now())

  certificat Certificat?

  @@unique([eleveId, sessionId])
  @@index([sessionId])
}

model Lecon {
  id          String   @id @default(cuid())
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  formationId String
  titre       String
  ordre       Int
  videoUrl    String?
  pdfUrl      String?

  quiz         Quiz?
  progressions Progression[]

  @@index([formationId])
}

model Quiz {
  id        String   @id @default(cuid())
  lecon     Lecon    @relation(fields: [leconId], references: [id], onDelete: Cascade)
  leconId   String   @unique
  questions Json
}

model Progression {
  id        String   @id @default(cuid())
  eleve     User     @relation(fields: [eleveId], references: [id])
  eleveId   String
  lecon     Lecon    @relation(fields: [leconId], references: [id])
  leconId   String
  terminee  Boolean  @default(false)
  score     Int?
  updatedAt DateTime @updatedAt

  @@unique([eleveId, leconId])
}

model Certificat {
  id            String      @id @default(cuid())
  inscription   Inscription @relation(fields: [inscriptionId], references: [id])
  inscriptionId String      @unique
  eleve         User        @relation(fields: [eleveId], references: [id])
  eleveId       String
  numero        String      @unique
  pdfUrl        String?
  delivreLe     DateTime    @default(now())
}

model Prestation {
  id             String   @id @default(cuid())
  nom            String
  dureeMinutes   Int
  prixFcfa       Int
  acompteRequis  Int?
  photo          String?
  actif          Boolean  @default(true)

  rendezVous RendezVous[]
}

model RendezVous {
  id            String     @id @default(cuid())
  cliente       User       @relation("ClienteRdv", fields: [clienteId], references: [id])
  clienteId     String
  prestation    Prestation @relation(fields: [prestationId], references: [id])
  prestationId  String
  maquilleuse   User?      @relation("MaquilleuseRdv", fields: [maquilleuseId], references: [id])
  maquilleuseId String?
  date          DateTime
  statut        StatutRdv  @default(EN_ATTENTE)
  origine       OrigineRdv @default(EN_LIGNE)
  createdAt     DateTime   @default(now())

  paiement Paiement?

  @@index([date])
  @@index([maquilleuseId])
}

model DemandeDevis {
  id            String        @id @default(cuid())
  nom           String
  telephone     String
  email         String?
  typeEvenement TypeEvenement
  precision     String?
  date          DateTime
  ville         String
  message       String?
  statut        StatutDevis   @default(NOUVEAU)
  createdAt     DateTime      @default(now())
  user          User?         @relation(fields: [userId], references: [id])
  userId        String?

  @@index([statut])
}

model Produit {
  id           String   @id @default(cuid())
  nom          String
  prixFcfa     Int
  photos       String[]
  categorie    String
  stock        Int      @default(0)
  seuilAlerte  Int      @default(5)
  createdAt    DateTime @default(now())

  lignesCommande LigneCommande[]
}

model Commande {
  id          String         @id @default(cuid())
  cliente     User           @relation(fields: [clienteId], references: [id])
  clienteId   String
  totalFcfa   Int
  livraison   TypeLivraison
  adresse     String?
  statut      StatutCommande @default(EN_ATTENTE)
  createdAt   DateTime       @default(now())

  lignes   LigneCommande[]
  paiement Paiement?
}

model LigneCommande {
  id           String   @id @default(cuid())
  commande     Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  commandeId   String
  produit      Produit  @relation(fields: [produitId], references: [id])
  produitId    String
  quantite     Int
  prixUnitaire Int

  @@index([commandeId])
}

model Paiement {
  id             String         @id @default(cuid())
  user           User           @relation(fields: [userId], references: [id])
  userId         String
  montantFcfa    Int
  moyen          MoyenPaiement
  type           TypePaiement
  estAcompte     Boolean        @default(false)
  resteDuFcfa    Int            @default(0)
  referenceExt   String?
  statut         StatutPaiement @default(EN_ATTENTE)
  createdAt      DateTime       @default(now())

  rendezVous   RendezVous? @relation(fields: [rendezVousId], references: [id])
  rendezVousId String?     @unique
  commande     Commande?   @relation(fields: [commandeId], references: [id])
  commandeId   String?     @unique

  @@index([userId])
}

model HoraireOuverture {
  id         String  @id @default(cuid())
  jour       Int     @unique
  ouvert     Boolean @default(true)
  heureDebut String
  heureFin   String
}

model JourFerme {
  id    String   @id @default(cuid())
  date  DateTime @unique @db.Date
  motif String?
}

model PhotoGalerie {
  id        String   @id @default(cuid())
  url       String
  legende   String?
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContenuSite {
  id          String   @id @default(cuid())
  cle         String   @unique
  valeur      String
  updatedAt   DateTime @updatedAt
}

model Notification {
  id           String            @id @default(cuid())
  destinataire User              @relation(fields: [destinataireId], references: [id])
  destinataireId String
  canal        CanalNotification
  type         TypeNotification
  statut       StatutEnvoi       @default(EN_ATTENTE)
  createdAt    DateTime          @default(now())

  @@index([destinataireId])
}
